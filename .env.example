# --- Database (Supabase) -----------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the Session pooler string (port 5432), not the direct connection.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Gemini (Google AI Studio) ----------------------------------------------
# https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# gemini-3.5-flash is the default. gemini-3.1-flash-lite is ~6x cheaper if cost matters.
GEMINI_MODEL=gemini-3.5-flash

# --- Dashboard access --------------------------------------------------------
# The single shared password for the operational dashboard.
DASHBOARD_PASSWORD=
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Storage -----------------------------------------------------------------
# Where reel videos and thumbnails live. On Fly this is the mounted volume.
# Locally, use something like ./.data
DATA_DIR=/data

# --- Worker ------------------------------------------------------------------
WORKER_ENABLED=true
MAX_ATTEMPTS=5

# --- Meta / Instagram webhook (final phase only) ----------------------------
# Meta app dashboard -> App settings -> Basic -> App secret
IG_APP_SECRET=
# Any random string; you type the same value into the Meta webhook config UI.
IG_WEBHOOK_VERIFY_TOKEN=
# Optional. Only needed for setup probes or future outbound Conversations API calls.
IG_ACCESS_TOKEN=
